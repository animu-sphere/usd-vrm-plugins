        customData = {
            string userDocBrief = "glTF alphaCutoff."
        }
    )
    uniform token inputs:vrm:material:alphaMode (
        customData = {
            string userDocBrief = """glTF alphaMode: 'OPAQUE', 'MASK' or 'BLEND'; unauthored means
        'OPAQUE', as in glTF."""
        }
    )
    float inputs:vrm:material:baseColorAlphaFactor = 1 (
        customData = {
            string userDocBrief = "Alpha (fourth component) of glTF pbrMetallicRoughness.baseColorFactor."
        }
    )
    color3f inputs:vrm:material:baseColorFactor = (1, 1, 1) (
        customData = {
            string userDocBrief = "RGB of glTF pbrMetallicRoughness.baseColorFactor."
        }
    )
    uniform bool inputs:vrm:material:doubleSided = 0 (
        customData = {
            string userDocBrief = "glTF doubleSided."
        }
    )
    color3f inputs:vrm:material:emissiveFactor = (0, 0, 0) (
        customData = {
            string userDocBrief = "glTF emissiveFactor."
        }
    )
    float inputs:vrm:material:emissiveStrength = 1 (
        customData = {
            string userDocBrief = """KHR_materials_emissive_strength.emissiveStrength: a multiplier
        on emissiveFactor, kept separate so the factor stays the glTF value."""
        }
    )
    float inputs:vrm:material:metallicFactor = 1 (
        customData = {
            string userDocBrief = "glTF pbrMetallicRoughness.metallicFactor."
        }
    )
    float inputs:vrm:material:roughnessFactor = 1 (
        customData = {
            string userDocBrief = "glTF pbrMetallicRoughness.roughnessFactor."
        }
    )
    uniform bool inputs:vrm:material:unlit = 0 (
        customData = {
            string userDocBrief = "Whether the source material declares KHR_materials_unlit."
        }
    )
}

