#usda 1.0
(
    """
    vrmSchema - typed VRM control-semantics API schemas, generated by
    `usdGenSchema schema.usda <codeGenPath>` and compiled into the vrmSchema
    plugin bundle (split out of the usdVrm file-format bundle; see
    docs/architecture/WORKSPACE.md). The GLOBAL naming below keeps the
    pre-split C++ spelling (UsdVrm* classes, UsdVrmTokens, USDVRM_API) so the
    split does not change the public C++ surface.

    Phase 4 formalizes what the authorer writes under /Asset/rig/* today as raw
    `vrm:*` tokens: VrmHumanoidAPI, VrmExpressionAPI, VrmLookAtAPI,
    VrmSpringBoneAPI, VrmColliderAPI, and VrmConstraintAPI. Skeleton-relative
    classes name joints by token (a joint token is a real entry in
    Skeleton.joints, which is not a prim, so a relationship cannot target it
    directly), some carrying a resolvable relationship to the UsdSkelSkeleton,
    plus the per-class control parameters defined below.
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName      = "usdVrm"
        string libraryPath      = "."
        # Prefix "Usd" so the class name (VrmHumanoidAPI) yields C++
        # UsdVrmHumanoidAPI (not UsdVrm + VrmHumanoidAPI = double "Vrm"), while the
        # USD schema identifier / apiSchemas token stays the self-describing
        # "VrmHumanoidAPI". tokensPrefix "UsdVrm" -> UsdVrmTokens (no clash with
        # core UsdTokens).
        string libraryPrefix    = "Usd"
        string tokensPrefix     = "UsdVrm"
        bool skipCodeGeneration = false
    }
)
{
}

class "VrmHumanoidAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """Maps VRM humanoid bones to USD skeleton joints. Apply to the
    /Asset/rig/Humanoid prim. `vrm:skeleton` resolves to the UsdSkelSkeleton; each
    `vrm:humanBones:<bone>` token holds the joint's path token within
    Skeleton.joints. Bones absent from the source VRM are simply not authored;
    non-standard bones outside this set are preserved as custom attributes."""
)
{
    rel vrm:skeleton (
        doc = "The UsdSkelSkeleton whose joints the human bones name."
    )

    # Torso / head.
    uniform token vrm:humanBones:hips (doc = "VRM human bone 'hips'.")
    uniform token vrm:humanBones:spine (doc = "VRM human bone 'spine'.")
    uniform token vrm:humanBones:chest (doc = "VRM human bone 'chest'.")
    uniform token vrm:humanBones:upperChest (doc = "VRM human bone 'upperChest'.")
    uniform token vrm:humanBones:neck (doc = "VRM human bone 'neck'.")
    uniform token vrm:humanBones:head (doc = "VRM human bone 'head'.")
    uniform token vrm:humanBones:leftEye (doc = "VRM human bone 'leftEye'.")
    uniform token vrm:humanBones:rightEye (doc = "VRM human bone 'rightEye'.")
    uniform token vrm:humanBones:jaw (doc = "VRM human bone 'jaw'.")

    # Legs.
    uniform token vrm:humanBones:leftUpperLeg (doc = "VRM human bone 'leftUpperLeg'.")
    uniform token vrm:humanBones:leftLowerLeg (doc = "VRM human bone 'leftLowerLeg'.")
    uniform token vrm:humanBones:leftFoot (doc = "VRM human bone 'leftFoot'.")
    uniform token vrm:humanBones:leftToes (doc = "VRM human bone 'leftToes'.")
    uniform token vrm:humanBones:rightUpperLeg (doc = "VRM human bone 'rightUpperLeg'.")
    uniform token vrm:humanBones:rightLowerLeg (doc = "VRM human bone 'rightLowerLeg'.")
    uniform token vrm:humanBones:rightFoot (doc = "VRM human bone 'rightFoot'.")
    uniform token vrm:humanBones:rightToes (doc = "VRM human bone 'rightToes'.")

    # Arms.
    uniform token vrm:humanBones:leftShoulder (doc = "VRM human bone 'leftShoulder'.")
    uniform token vrm:humanBones:leftUpperArm (doc = "VRM human bone 'leftUpperArm'.")
    uniform token vrm:humanBones:leftLowerArm (doc = "VRM human bone 'leftLowerArm'.")
    uniform token vrm:humanBones:leftHand (doc = "VRM human bone 'leftHand'.")
    uniform token vrm:humanBones:rightShoulder (doc = "VRM human bone 'rightShoulder'.")
    uniform token vrm:humanBones:rightUpperArm (doc = "VRM human bone 'rightUpperArm'.")
    uniform token vrm:humanBones:rightLowerArm (doc = "VRM human bone 'rightLowerArm'.")
    uniform token vrm:humanBones:rightHand (doc = "VRM human bone 'rightHand'.")

    # Left fingers.
    uniform token vrm:humanBones:leftThumbMetacarpal (doc = "VRM 1.0 human bone 'leftThumbMetacarpal'.")
    uniform token vrm:humanBones:leftThumbProximal (doc = "VRM human bone 'leftThumbProximal'.")
    uniform token vrm:humanBones:leftThumbDistal (doc = "VRM human bone 'leftThumbDistal'.")
    uniform token vrm:humanBones:leftIndexProximal (doc = "VRM human bone 'leftIndexProximal'.")
    uniform token vrm:humanBones:leftIndexIntermediate (doc = "VRM human bone 'leftIndexIntermediate'.")
    uniform token vrm:humanBones:leftIndexDistal (doc = "VRM human bone 'leftIndexDistal'.")
    uniform token vrm:humanBones:leftMiddleProximal (doc = "VRM human bone 'leftMiddleProximal'.")
    uniform token vrm:humanBones:leftMiddleIntermediate (doc = "VRM human bone 'leftMiddleIntermediate'.")
    uniform token vrm:humanBones:leftMiddleDistal (doc = "VRM human bone 'leftMiddleDistal'.")
    uniform token vrm:humanBones:leftRingProximal (doc = "VRM human bone 'leftRingProximal'.")
    uniform token vrm:humanBones:leftRingIntermediate (doc = "VRM human bone 'leftRingIntermediate'.")
    uniform token vrm:humanBones:leftRingDistal (doc = "VRM human bone 'leftRingDistal'.")
    uniform token vrm:humanBones:leftLittleProximal (doc = "VRM human bone 'leftLittleProximal'.")
    uniform token vrm:humanBones:leftLittleIntermediate (doc = "VRM human bone 'leftLittleIntermediate'.")
    uniform token vrm:humanBones:leftLittleDistal (doc = "VRM human bone 'leftLittleDistal'.")

    # Right fingers.
    uniform token vrm:humanBones:rightThumbMetacarpal (doc = "VRM 1.0 human bone 'rightThumbMetacarpal'.")
    uniform token vrm:humanBones:rightThumbProximal (doc = "VRM human bone 'rightThumbProximal'.")
    uniform token vrm:humanBones:rightThumbDistal (doc = "VRM human bone 'rightThumbDistal'.")
    uniform token vrm:humanBones:rightIndexProximal (doc = "VRM human bone 'rightIndexProximal'.")
    uniform token vrm:humanBones:rightIndexIntermediate (doc = "VRM human bone 'rightIndexIntermediate'.")
    uniform token vrm:humanBones:rightIndexDistal (doc = "VRM human bone 'rightIndexDistal'.")
    uniform token vrm:humanBones:rightMiddleProximal (doc = "VRM human bone 'rightMiddleProximal'.")
    uniform token vrm:humanBones:rightMiddleIntermediate (doc = "VRM human bone 'rightMiddleIntermediate'.")
    uniform token vrm:humanBones:rightMiddleDistal (doc = "VRM human bone 'rightMiddleDistal'.")
    uniform token vrm:humanBones:rightRingProximal (doc = "VRM human bone 'rightRingProximal'.")
    uniform token vrm:humanBones:rightRingIntermediate (doc = "VRM human bone 'rightRingIntermediate'.")
    uniform token vrm:humanBones:rightRingDistal (doc = "VRM human bone 'rightRingDistal'.")
    uniform token vrm:humanBones:rightLittleProximal (doc = "VRM human bone 'rightLittleProximal'.")
    uniform token vrm:humanBones:rightLittleIntermediate (doc = "VRM human bone 'rightLittleIntermediate'.")
    uniform token vrm:humanBones:rightLittleDistal (doc = "VRM human bone 'rightLittleDistal'.")
}

class "VrmExpressionAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """A VRM expression (VRM 1.0 Expression / VRM 0.x BlendShapeGroup). Apply
    to each /Asset/rig/Expressions/<name> prim. Morph-target and material-color
    bindings are authored as relationships with parallel value arrays; evaluation is
    a downstream-runtime concern. Per-expression curves and unmapped data stay in
    customData."""
)
{
    uniform token vrm:expressionName (
        doc = """The expression name exactly as the source VRM spelled it. The prim
        name is a sanitized, uniquified identifier and is not a join key: a clip
        and an avatar sanitize independently, so a non-ASCII or colliding name
        lands on a different prim name on each side. This attribute is the key
        that survives, and it is the same one a .vrma clip authors on
        /Animation/Expressions/<name>."""
    )
    uniform token vrm:expressionType (
        doc = "'preset' for a standard VRM expression, 'custom' otherwise."
    )
    uniform bool vrm:isBinary (
        doc = "Whether the expression value is clamped to 0/1 (binary)."
    )
    uniform token vrm:overrideBlink (
        doc = """What this expression does to the blink expressions while on.
        'none', 'block' (they are off whenever this one is on at all) or 'blend'
        (they are attenuated by this expression's own weight). VRM 1.0's
        `overrideBlink`, and the only mechanism the specification gives for two
        co-active expressions whose morph targets displace the same vertices --
        their offsets otherwise sum, and an eyelid driven by a blink and a smile
        at once is driven roughly twice as far as shut. Authored only when the
        source file states it; VRM 0.x has no such field. The token is carried
        as the file spelled it and is not constrained by an allowedTokens list,
        so a value outside the three reaches a consumer as data rather than
        failing schema validation."""
    )
    uniform token vrm:overrideLookAt (
        doc = """What this expression does to the look-at expressions while on.
        The same three tokens, over lookUp, lookDown, lookLeft and lookRight --
        which is how one expression arbitrates the gaze of a rig that aims its
        eyes with expressions rather than with bones."""
    )
    uniform token vrm:overrideMouth (
        doc = """What this expression does to the mouth expressions while on.
        The same three tokens, over aa, ih, ou, ee and oh."""
    )
    rel vrm:morphTargets (
        doc = "The UsdSkelBlendShape prims this expression drives."
    )
    uniform float[] vrm:morphTargetWeights (
        doc = "Per-target weights, parallel to vrm:morphTargets."
    )
    rel vrm:materialColorTargets (
        doc = "The materials whose colors this expression overrides."
    )
    uniform token[] vrm:materialColorTypes (
        doc = "Color slot per target (e.g. color, emission), parallel to vrm:materialColorTargets."
    )
    uniform float4[] vrm:materialColorValues (
        doc = "Target RGBA per material color bind, parallel to vrm:materialColorTargets."
    )
}

class "VrmLookAtAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """VRM lookAt configuration. Apply to /Asset/rig/LookAt. The eyes name
    skeleton joints by token (joints are Skeleton.joints tokens, not prims); the
    range-map curves are preserved verbatim in customData (vrm:lookAt:raw)."""
)
{
    uniform token vrm:type (
        doc = "'bone' (eyes driven by joints) or 'expression'."
    )
    rel vrm:skeleton (
        doc = "The UsdSkelSkeleton the eye joint tokens belong to."
    )
    uniform token vrm:leftEye (
        doc = "Joint path token (within Skeleton.joints) of the left eye."
    )
    uniform token vrm:rightEye (
        doc = "Joint path token (within Skeleton.joints) of the right eye."
    )
}

class "VrmSpringBoneAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """A VRM SpringBone chain (secondary motion, data only - no simulation).
    Apply to each /Asset/rig/SecondaryMotion/SpringBones/<name> prim. The per-joint
    parameter arrays are parallel to vrm:joints. gravityDir is model-space (it takes
    the VRM-0.x front bake). Colliders are referenced by relationship."""
)
{
    uniform token[] vrm:joints (
        doc = "Ordered joint path tokens forming the spring chain."
    )
    uniform float[] vrm:stiffness (doc = "Per-joint stiffness, parallel to vrm:joints.")
    uniform float[] vrm:gravityPower (doc = "Per-joint gravity power, parallel to vrm:joints.")
    uniform float[] vrm:dragForce (doc = "Per-joint drag force, parallel to vrm:joints.")
    uniform float[] vrm:hitRadius (doc = "Per-joint hit radius, parallel to vrm:joints.")
    uniform float3[] vrm:gravityDir (doc = "Per-joint gravity direction (model space), parallel to vrm:joints.")
    uniform token vrm:center (
        doc = "Optional center joint token for inertial reference."
    )
    rel vrm:colliderGroups (
        doc = "The collider-group prims this chain collides against."
    )
}

class "VrmColliderAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """A single VRM SpringBone collider (data only). Apply to each
    /Asset/rig/SecondaryMotion/Colliders/<group>/Collider_<n> prim. vrm:tail is only
    meaningful for capsule shapes."""
)
{
    uniform token vrm:shape (doc = "'sphere' or 'capsule'.")
    uniform token vrm:node (doc = "Joint path token the collider is attached to.")
    uniform float3 vrm:offset (doc = "Collider center offset from its node.")
    uniform float vrm:radius (doc = "Collider radius.")
    uniform float3 vrm:tail (doc = "Capsule tail position (capsule shape only).")
}

class "VrmConstraintAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = """A VRM node constraint (VRMC_node_constraint, data only - the constraint
    is not baked). Apply to each /Asset/rig/Constraints/<name> prim. The constrained
    and source nodes are named by joint path token (joints are Skeleton.joints tokens,
    not prims); the full constraint block is preserved as customData
    (vrm:constraint:raw). VRM 1.0 only; VRM 0.x has no node-constraint equivalent."""
)
{
    uniform token vrm:type (
        doc = "Constraint type: 'roll', 'aim', or 'rotation'."
    )
    uniform token vrm:constrained (
        doc = "Joint path token of the constrained (driven) node."
    )
    uniform token vrm:source (
        doc = "Joint path token of the source (driving) node."
    )
    uniform token vrm:axis (
        doc = "Constraint axis ('X'/'Y'/'Z'); absent for rotation constraints."
    )
    uniform float vrm:weight (
        doc = "Constraint weight in [0,1]."
    )
}

# ---------------------------------------------------------------------------
# Canonical material semantics (Product P5 Step 3; material policy §6).
#
# Applied to the UsdShadeMaterial at /Asset/mtl/<name> itself, never to a
# child prim: the hierarchy below a material is reserved for rendering
# realizations (/preview, /mtlx), and every realization is generated from
# these attributes and from nothing else (policy §3, §6.5).
#
# Every property is a Material interface input -- `inputs:vrm:...` -- rather
# than a plain `vrm:` attribute (policy §11 q9). UsdShade connects only
# `inputs:` / `outputs:` attributes, so a realization graph can read a
# canonical value only through an interface connection, and an animated value
# (an expression's material-colour bind, policy §6.7) reaches whichever
# realization the renderer selects only that way. A connection from a graph to
# a plain `vrm:` attribute is discarded as an invalid source and the input
# silently falls back to the shader's own default.
#
# Fallbacks are the VRM / glTF specification defaults, for readers. They are
# NOT what a connected realization sees: UsdShade resolves an interface
# connection to an *authored* value only, so a writer authors every value a
# graph connects to.
#
# Token-valued properties carry no allowedTokens list, as for
# VrmExpressionAPI's overrides: a value outside the documented set reaches a
# consumer as data, and tools/validate_vrm.py reports it.
# ---------------------------------------------------------------------------

class "VrmMaterialAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Material"]
    }
    doc = """Generic source material semantics of one glTF / VRM material: the
    glTF 2.0 metallic-roughness core plus the two material extensions VRM
    avatars rely on (KHR_materials_unlit, KHR_materials_emissive_strength).
    Apply to the /Asset/mtl/<name> UsdShadeMaterial. Texture-bound values
    (normal scale, occlusion strength, every texture's asset and UV state) are
    VrmTextureInfoAPI instances on the same prim. Colours are linear, as glTF
    defines them. UsdPreviewSurface and MaterialX inputs are realizations of
    these values and are never storage."""
)
{
    color3f inputs:vrm:material:baseColorFactor = (1, 1, 1) (
        doc = """RGB of glTF pbrMetallicRoughness.baseColorFactor. glTF's
        factor is RGBA; it is split so each half connects to a colour and a
        float input without a conversion node in every realization."""
        customData = { string apiName = "baseColorFactor" }
    )
    float inputs:vrm:material:baseColorAlphaFactor = 1 (
        doc = "Alpha (fourth component) of glTF pbrMetallicRoughness.baseColorFactor."
        customData = { string apiName = "baseColorAlphaFactor" }
    )
    float inputs:vrm:material:metallicFactor = 1 (
        doc = "glTF pbrMetallicRoughness.metallicFactor."
        customData = { string apiName = "metallicFactor" }
    )
    float inputs:vrm:material:roughnessFactor = 1 (
        doc = "glTF pbrMetallicRoughness.roughnessFactor."
        customData = { string apiName = "roughnessFactor" }
    )
    color3f inputs:vrm:material:emissiveFactor = (0, 0, 0) (
        doc = "glTF emissiveFactor."
        customData = { string apiName = "emissiveFactor" }
    )
    float inputs:vrm:material:emissiveStrength = 1 (
        doc = """KHR_materials_emissive_strength.emissiveStrength: a multiplier
        on emissiveFactor, kept separate so the factor stays the glTF value."""
        customData = { string apiName = "emissiveStrength" }
    )
    uniform token inputs:vrm:material:alphaMode (
        doc = """glTF alphaMode: 'OPAQUE', 'MASK' or 'BLEND'; unauthored means
        'OPAQUE', as in glTF. The one property without a schema fallback:
        usdGenSchema would name the fallback's C++ token `OPAQUE`, which is a
        Windows (wingdi.h) macro and breaks every translation unit that sees
        both."""
        customData = { string apiName = "alphaMode" }
    )
    float inputs:vrm:material:alphaCutoff = 0.5 (
        doc = "glTF alphaCutoff. Meaningful only when alphaMode is 'MASK'."
        customData = { string apiName = "alphaCutoff" }
    )
    uniform bool inputs:vrm:material:doubleSided = false (
        doc = "glTF doubleSided."
        customData = { string apiName = "doubleSided" }
    )
    uniform bool inputs:vrm:material:unlit = false (
        doc = """Whether the source material declares KHR_materials_unlit. VRM
        MToon materials usually do, as their glTF-only fallback."""
        customData = { string apiName = "unlit" }
    )
}

class "VrmMToonAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Material"]
    }
    doc = """MToon source semantics: the VRMC_materials_mtoon 1.0 model, as
    data and not as a shader. Apply to the /Asset/mtl/<name> UsdShadeMaterial
    alongside VrmMaterialAPI, which carries the glTF core the MToon model
    builds on. Property names are the specification's field names verbatim.
    A VRM 0.x MToon material (Unity property names) is normalized into the same
    fields at the importer boundary; this schema has no version switch. Fields
    that no portable realization reproduces -- outline, render queue,
    transparent-with-z-write, UV animation -- are canonical all the same: the
    renderer decides what to do with them. MToon textures are
    VrmTextureInfoAPI instances on the same prim. The source block stays at
    customData `vrm:mtoon:raw` as the lossless fallback and is never a runtime
    API."""
)
{
    uniform token inputs:vrm:mtoon:specVersion = "1.0" (
        doc = """The VRMC_materials_mtoon version whose model these values
        follow. A VRM 0.x source is normalized into the 1.0 model and carries
        that model's version, not its own; the raw block keeps the original."""
        customData = { string apiName = "specVersion" }
    )

    # Rendering.
    uniform bool inputs:vrm:mtoon:transparentWithZWrite = false (
        doc = "VRMC_materials_mtoon transparentWithZWrite."
        customData = { string apiName = "transparentWithZWrite" }
    )
    uniform int inputs:vrm:mtoon:renderQueueOffsetNumber = 0 (
        doc = "VRMC_materials_mtoon renderQueueOffsetNumber."
        customData = { string apiName = "renderQueueOffsetNumber" }
    )

    # Shading.
    color3f inputs:vrm:mtoon:shadeColorFactor = (1, 1, 1) (
        doc = "VRMC_materials_mtoon shadeColorFactor (linear)."
        customData = { string apiName = "shadeColorFactor" }
    )
    float inputs:vrm:mtoon:shadingShiftFactor = 0 (
        doc = "VRMC_materials_mtoon shadingShiftFactor."
        customData = { string apiName = "shadingShiftFactor" }
    )
    float inputs:vrm:mtoon:shadingToonyFactor = 0.9 (
        doc = "VRMC_materials_mtoon shadingToonyFactor."
        customData = { string apiName = "shadingToonyFactor" }
    )
    float inputs:vrm:mtoon:giEqualizationFactor = 0.9 (
        doc = "VRMC_materials_mtoon giEqualizationFactor."
        customData = { string apiName = "giEqualizationFactor" }
    )

    # MatCap.
    color3f inputs:vrm:mtoon:matcapFactor = (1, 1, 1) (
        doc = "VRMC_materials_mtoon matcapFactor (linear)."
        customData = { string apiName = "matcapFactor" }
    )

    # Rim.
    color3f inputs:vrm:mtoon:parametricRimColorFactor = (0, 0, 0) (
        doc = "VRMC_materials_mtoon parametricRimColorFactor (linear)."
        customData = { string apiName = "parametricRimColorFactor" }
    )
    float inputs:vrm:mtoon:parametricRimFresnelPowerFactor = 5 (
        doc = "VRMC_materials_mtoon parametricRimFresnelPowerFactor."
        customData = { string apiName = "parametricRimFresnelPowerFactor" }
    )
    float inputs:vrm:mtoon:parametricRimLiftFactor = 0 (
        doc = "VRMC_materials_mtoon parametricRimLiftFactor."
        customData = { string apiName = "parametricRimLiftFactor" }
    )
    float inputs:vrm:mtoon:rimLightingMixFactor = 1 (
        doc = "VRMC_materials_mtoon rimLightingMixFactor."
        customData = { string apiName = "rimLightingMixFactor" }
    )

    # Outline.
    uniform token inputs:vrm:mtoon:outlineWidthMode = "none" (
        doc = """VRMC_materials_mtoon outlineWidthMode: 'none',
        'worldCoordinates' or 'screenCoordinates'. An MToon semantic, not a
        rendering instruction: how an outline is drawn is the renderer's
        decision."""
        customData = { string apiName = "outlineWidthMode" }
    )
    float inputs:vrm:mtoon:outlineWidthFactor = 0 (
        doc = "VRMC_materials_mtoon outlineWidthFactor."
        customData = { string apiName = "outlineWidthFactor" }
    )
    color3f inputs:vrm:mtoon:outlineColorFactor = (0, 0, 0) (
        doc = "VRMC_materials_mtoon outlineColorFactor (linear)."
        customData = { string apiName = "outlineColorFactor" }
    )
    float inputs:vrm:mtoon:outlineLightingMixFactor = 1 (
        doc = "VRMC_materials_mtoon outlineLightingMixFactor."
        customData = { string apiName = "outlineLightingMixFactor" }
    )

    # UV animation.
    float inputs:vrm:mtoon:uvAnimationScrollXSpeedFactor = 0 (
        doc = "VRMC_materials_mtoon uvAnimationScrollXSpeedFactor."
        customData = { string apiName = "uvAnimationScrollXSpeedFactor" }
    )
    float inputs:vrm:mtoon:uvAnimationScrollYSpeedFactor = 0 (
        doc = "VRMC_materials_mtoon uvAnimationScrollYSpeedFactor."
        customData = { string apiName = "uvAnimationScrollYSpeedFactor" }
    )
    float inputs:vrm:mtoon:uvAnimationRotationSpeedFactor = 0 (
        doc = "VRMC_materials_mtoon uvAnimationRotationSpeedFactor."
        customData = { string apiName = "uvAnimationRotationSpeedFactor" }
    )
}

class "VrmTextureInfoAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "multipleApply"
        token propertyNamespacePrefix = "inputs:vrm:textureInfo"
        token[] apiSchemaCanOnlyApplyTo = ["Material"]
        token[] apiSchemaAllowedInstanceNames = [
            "baseColor", "metallicRoughness", "normal", "occlusion", "emissive",
            "shadeMultiply", "shadingShift", "matcap", "rimMultiply",
            "outlineWidthMultiply", "uvAnimationMask"
        ]
    }
    doc = """One texture a material samples, by role. Apply once per role to
    the /Asset/mtl/<name> UsdShadeMaterial; the instance name is the role,
    spelled as the source specification spells the texture without its
    'Texture' suffix: the five glTF core textures and the six
    VRMC_materials_mtoon textures. Only these eleven instance names are
    allowed. Whether a texture is colour (sRGB) or data is fixed by its role
    and is not stored. KHR_texture_transform lives under `transform:`, apart
    from the texture's own contribution scalars (`scale`, `strength`): a UV
    scale and a contribution scale are different quantities."""
)
{
    asset file (
        doc = """The image, as a USD asset path (an external file or a path
        inside the .vrm package)."""
    )
    uniform int texCoord = 0 (
        doc = """The TEXCOORD_<n> set sampled. The effective set: a
        KHR_texture_transform texCoord override is folded in by the importer."""
    )
    uniform token wrapS = "repeat" (
        doc = "glTF sampler wrapS: 'repeat', 'clampToEdge' or 'mirroredRepeat'."
    )
    uniform token wrapT = "repeat" (
        doc = "glTF sampler wrapT: 'repeat', 'clampToEdge' or 'mirroredRepeat'."
    )
    float scale = 1 (
        doc = """Contribution scale: glTF normalTexture.scale, or
        VRMC_materials_mtoon shadingShiftTexture.scale. Not a UV scale, and
        meaningless on any other role."""
    )
    float strength = 1 (
        doc = "glTF occlusionTexture.strength. Meaningless on any other role."
    )
    float2 transform:offset = (0, 0) (
        doc = "KHR_texture_transform offset."
        customData = { string apiName = "transformOffset" }
    )
    float transform:rotation = 0 (
        doc = "KHR_texture_transform rotation, in radians, as glTF defines it."
        customData = { string apiName = "transformRotation" }
    )
    float2 transform:scale = (1, 1) (
        doc = "KHR_texture_transform scale: a UV scale, not the contribution scale above."
        customData = { string apiName = "transformScale" }
    )
}
