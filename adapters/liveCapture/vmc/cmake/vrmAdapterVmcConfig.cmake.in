@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# OpenUSD's pxrConfig.cmake defines imported targets unconditionally, so skip it
# when a consumer has already resolved the Gf target this package needs
# transitively through motionCore.
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
if(NOT TARGET motionRuntime::motionRuntime)
    find_dependency(motionRuntime CONFIG REQUIRED)
endif()
# The live half's shared leaf, which now carries the socket, the capture format
# and the diagnostic vehicle (WORKSPACE.md §2). Its own config brings the
# platform's threading primitive with it, so there is no `find_dependency(Threads)`
# on this line any more: the mutex belongs to that library's queue and so does
# the dependency that resolves it.
if(NOT TARGET liveTransport::liveTransport)
    find_dependency(liveTransport CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vrmAdapterVmcTargets.cmake")
check_required_components(vrmAdapterVmc)
