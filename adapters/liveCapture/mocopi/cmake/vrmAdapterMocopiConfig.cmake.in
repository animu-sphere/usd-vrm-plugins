@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# OpenUSD's pxrConfig.cmake defines imported targets unconditionally, so skip it
# when a consumer has already resolved the Gf target this package needs
# transitively through motionCore.
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
if(NOT TARGET motionRuntime::motionRuntime)
    find_dependency(motionRuntime CONFIG REQUIRED)
endif()
# Still no find_dependency for the transport, now that the receiver exists, and
# that is a fact about what it links rather than an omission. The exported target
# carries `ws2_32` on Windows, which is a raw library name the linker resolves
# from the SDK — not an imported target — so there is nothing for a consumer to
# find and a `find_dependency` here would name a package that does not exist.
#
# The sibling's config does carry one, because it links `Threads::Threads` for a
# datagram queue's mutex, and that *is* an imported target: unresolved, it is a
# configure error rather than a link one. This adapter has no queue, so it needs
# no threading package. If one is ever linked here, the find_dependency lands in
# the same change.
include("${CMAKE_CURRENT_LIST_DIR}/vrmAdapterMocopiTargets.cmake")
check_required_components(vrmAdapterMocopi)
