@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# OpenUSD's pxrConfig.cmake defines imported targets unconditionally, so skip it
# when a consumer has already resolved the Gf target this package needs
# transitively through motionCore. The same guard both siblings carry, arriving
# here with VRC-3 for the same reason: this adapter now holds canonical values.
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
# The value types, and the only route WORKSPACE.md §2 gives an adapter to them.
# There is still no `motionRuntime` here, and its absence is this adapter's
# shape rather than an omission: a tracker observation is not a pose, and the
# library that intakes poses arrives with the solve (VRC-5).
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
# The live half's shared leaf: the socket, the capture format and the diagnostic
# vehicle (WORKSPACE.md §2). Its own config brings the platform's threading
# primitive with it, so this file does not ask for one.
if(NOT TARGET liveTransport::liveTransport)
    find_dependency(liveTransport CONFIG REQUIRED)
endif()
# The OSC wire format, the other shared leaf. A sibling of the one above rather
# than a layer of it, so it is resolved separately: WORKSPACE.md §2 forbids an
# edge between the two in both directions, which means neither config can bring
# the other. Its own config asks for nothing at all -- it links no workspace
# library and no platform library either.
if(NOT TARGET osc::osc)
    find_dependency(osc CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vrmAdapterVrchatOscTargets.cmake")
check_required_components(vrmAdapterVrchatOsc)
