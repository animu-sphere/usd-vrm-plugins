#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Asset" (
    customData = {
        dictionary vrm = {
            bool frontAxisNormalized = 0
            string meta = '''{
    "authors": ["usd-vrm-plugins"],
    "avatarPermission": "everyone",
    "licenseUrl": "https://www.apache.org/licenses/LICENSE-2.0",
    "name": "usdVrm Fixture",
    "version": "1.0"
}'''
            string rawExtension = '{"specVersion":"1.0","meta":{"name":"usdVrm Fixture","version":"1.0","authors":["usd-vrm-plugins"],"licenseUrl":"https://www.apache.org/licenses/LICENSE-2.0","avatarPermission":"everyone"},"humanoid":{"humanBones":{}}}'
            int schemaContractVersion = 1
            string sourceFormat = "VRM"
            string sourceFrontAxis = "+Z"
            string sourceVersion = "1.0"
            string specVersion = "1.0"
        }
    }
    kind = "component"
)
{
    def Scope "mtl"
    {
        def Material "Skin" (
            apiSchemas = ["VrmMaterialAPI", "VrmMToonAPI", "VrmTextureInfoAPI:baseColor", "MaterialXConfigAPI"]
            customData = {
                dictionary vrm = {
                    dictionary mtoon = {
                        string raw = '{"specVersion":"1.0","shadeColorFactor":[0.5,0.2,0.2]}'
                    }
                    int sourceMaterialIndex = 0
                }
            }
        )
        {
            string config:mtlx:version = "1.39"
            float inputs:vrm:material:alphaCutoff = 0.5
            uniform token inputs:vrm:material:alphaMode = "OPAQUE"
            float inputs:vrm:material:baseColorAlphaFactor = 0.6
            color3f inputs:vrm:material:baseColorFactor = (0.5, 0.25, 0.75)
            uniform bool inputs:vrm:material:doubleSided = 0
            color3f inputs:vrm:material:emissiveFactor = (0, 0, 0)
            float inputs:vrm:material:emissiveStrength = 1
            float inputs:vrm:material:metallicFactor = 1
            float inputs:vrm:material:roughnessFactor = 1
            uniform bool inputs:vrm:material:unlit = 0
            float inputs:vrm:mtoon:giEqualizationFactor = 0.9
            color3f inputs:vrm:mtoon:matcapFactor = (1, 1, 1)
            color3f inputs:vrm:mtoon:outlineColorFactor = (0, 0, 0)
            float inputs:vrm:mtoon:outlineLightingMixFactor = 1
            float inputs:vrm:mtoon:outlineWidthFactor = 0
            uniform token inputs:vrm:mtoon:outlineWidthMode = "none"
            color3f inputs:vrm:mtoon:parametricRimColorFactor = (0, 0, 0)
            float inputs:vrm:mtoon:parametricRimFresnelPowerFactor = 5
            float inputs:vrm:mtoon:parametricRimLiftFactor = 0
            uniform int inputs:vrm:mtoon:renderQueueOffsetNumber = 0
            float inputs:vrm:mtoon:rimLightingMixFactor = 1
            color3f inputs:vrm:mtoon:shadeColorFactor = (0.5, 0.2, 0.2)
            float inputs:vrm:mtoon:shadingShiftFactor = 0
            float inputs:vrm:mtoon:shadingToonyFactor = 0.9
            uniform token inputs:vrm:mtoon:specVersion = "1.0"
            uniform bool inputs:vrm:mtoon:transparentWithZWrite = 0
            float inputs:vrm:mtoon:uvAnimationRotationSpeedFactor = 0
            float inputs:vrm:mtoon:uvAnimationScrollXSpeedFactor = 0
            float inputs:vrm:mtoon:uvAnimationScrollYSpeedFactor = 0
            asset inputs:vrm:textureInfo:baseColor:file = @${BUNDLE}/tests/fixtures/textures.vrm[images/0198c0f73fbeb889.png]@
            uniform int inputs:vrm:textureInfo:baseColor:texCoord = 0
            uniform token inputs:vrm:textureInfo:baseColor:wrapS = "repeat"
            uniform token inputs:vrm:textureInfo:baseColor:wrapT = "clampToEdge"
            token outputs:mtlx:surface.connect = </Asset/mtl/Skin/mtlx.outputs:surface>
            token outputs:surface.connect = </Asset/mtl/Skin/preview.outputs:surface>
            custom uniform token vrm:shaderModel = "MToon"

            def NodeGraph "preview"
            {
                token outputs:surface.connect = </Asset/mtl/Skin/preview/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.5, 0.25, 0.75)
                    color3f inputs:diffuseColor.connect = </Asset/mtl/Skin/preview/baseColorTexture.outputs:rgb>
                    color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 1
                    float inputs:opacity = 1
                    float inputs:roughness = 1
                    token outputs:surface
                }

                def Shader "stReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "baseColorTexture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @${BUNDLE}/tests/fixtures/textures.vrm[images/0198c0f73fbeb889.png]@
                    float4 inputs:scale = (0.5, 0.25, 0.75, 0.6)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Asset/mtl/Skin/preview/stReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "clamp"
                    float outputs:a
                    float outputs:b
                    float outputs:g
                    float outputs:r
                    float3 outputs:rgb
                }
            }

            def NodeGraph "mtlx"
            {
                token outputs:surface.connect = </Asset/mtl/Skin/mtlx/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "ND_gltf_pbr_surfaceshader"
                    float inputs:alpha = 1
                    int inputs:alpha_mode = 0
                    color3f inputs:base_color.connect = </Asset/mtl/Skin/mtlx/baseColorRgb.outputs:out>
                    color3f inputs:emissive = (0, 0, 0)
                    float inputs:emissive_strength = 1
                    float inputs:metallic = 1
                    float inputs:roughness = 1
                    token outputs:surface
                }

                def Shader "st"
                {
                    uniform token info:id = "ND_texcoord_vector2"
                    int inputs:index = 0
                    float2 outputs:out
                }

                def Shader "baseColorImage"
                {
                    uniform token info:id = "ND_image_color4"
                    color4f inputs:default = (0, 0, 0, 1)
                    asset inputs:file = @${BUNDLE}/tests/fixtures/textures.vrm[images/0198c0f73fbeb889.png]@ (
                        colorSpace = "srgb_texture"
                    )
                    float2 inputs:texcoord.connect = </Asset/mtl/Skin/mtlx/st.outputs:out>
                    string inputs:uaddressmode = "periodic"
                    string inputs:vaddressmode = "clamp"
                    color4f outputs:out
                }

                def Shader "baseColorFactor"
                {
                    uniform token info:id = "ND_multiply_color4"
                    color4f inputs:in1.connect = </Asset/mtl/Skin/mtlx/baseColorImage.outputs:out>
                    color4f inputs:in2 = (0.5, 0.25, 0.75, 0.6)
                    color4f outputs:out
                }

                def Shader "baseColorSplit"
                {
                    uniform token info:id = "ND_separate4_color4"
                    color4f inputs:in.connect = </Asset/mtl/Skin/mtlx/baseColorFactor.outputs:out>
                    float outputs:outa
                    float outputs:outb
                    float outputs:outg
                    float outputs:outr
                }

                def Shader "baseColorRgb"
                {
                    uniform token info:id = "ND_combine3_color3"
                    float inputs:in1.connect = </Asset/mtl/Skin/mtlx/baseColorSplit.outputs:outr>
                    float inputs:in2.connect = </Asset/mtl/Skin/mtlx/baseColorSplit.outputs:outg>
                    float inputs:in3.connect = </Asset/mtl/Skin/mtlx/baseColorSplit.outputs:outb>
                    color3f outputs:out
                }
            }
        }
    }

    def Scope "geo"
    {
        def Mesh "Body" (
            apiSchemas = ["MaterialBindingAPI"]
            customData = {
                dictionary vrm = {
                    int sourceMeshIndex = 0
                    int sourceNodeIndex = 0
                    string sourceNodeName = "Body"
                    int sourcePrimitiveIndex = 0
                }
            }
        )
        {
            float3[] extent = [(-0.5, 0, 0), (0.5, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            rel material:binding = </Asset/mtl/Skin>
            point3f[] points = [(-0.5, 0, 0), (0.5, 0, 0), (0, 1, 0)]
            texCoord2f[] primvars:st = [(0, 1), (1, 1), (0.5, 0)] (
                interpolation = "vertex"
            )
            uniform token subdivisionScheme = "none"
        }
    }

    def Scope "rig"
    {
    }
}

