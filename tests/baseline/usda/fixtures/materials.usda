#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Asset" (
    customData = {
        dictionary vrm = {
            bool frontAxisNormalized = 0
            string meta = '''{
    "authors": ["usd-vrm-plugins"],
    "avatarPermission": "everyone",
    "licenseUrl": "https://www.apache.org/licenses/LICENSE-2.0",
    "name": "usdVrm Fixture",
    "version": "1.0"
}'''
            string rawExtension = '{"specVersion":"1.0","meta":{"name":"usdVrm Fixture","version":"1.0","authors":["usd-vrm-plugins"],"licenseUrl":"https://www.apache.org/licenses/LICENSE-2.0","avatarPermission":"everyone"},"humanoid":{"humanBones":{}}}'
            int schemaContractVersion = 1
            string sourceFormat = "VRM"
            string sourceFrontAxis = "+Z"
            string sourceVersion = "1.0"
            string specVersion = "1.0"
        }
    }
    kind = "component"
)
{
    def Scope "mtl"
    {
        def Material "Glass" (
            apiSchemas = ["VrmMaterialAPI", "MaterialXConfigAPI"]
            customData = {
                dictionary vrm = {
                    int sourceMaterialIndex = 0
                }
            }
        )
        {
            string config:mtlx:version = "1.39"
            float inputs:vrm:material:alphaCutoff = 0.5
            uniform token inputs:vrm:material:alphaMode = "BLEND"
            float inputs:vrm:material:baseColorAlphaFactor = 0.3
            color3f inputs:vrm:material:baseColorFactor = (0.2, 0.4, 0.9)
            uniform bool inputs:vrm:material:doubleSided = 1
            color3f inputs:vrm:material:emissiveFactor = (0, 0, 0)
            float inputs:vrm:material:emissiveStrength = 1
            float inputs:vrm:material:metallicFactor = 1
            float inputs:vrm:material:roughnessFactor = 1
            uniform bool inputs:vrm:material:unlit = 0
            token outputs:mtlx:surface.connect = </Asset/mtl/Glass/mtlx.outputs:surface>
            token outputs:surface.connect = </Asset/mtl/Glass/preview.outputs:surface>

            def NodeGraph "preview"
            {
                token outputs:surface.connect = </Asset/mtl/Glass/preview/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.2, 0.4, 0.9)
                    color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 1
                    float inputs:opacity = 0.3
                    float inputs:roughness = 1
                    token outputs:surface
                }
            }

            def NodeGraph "mtlx"
            {
                token outputs:surface.connect = </Asset/mtl/Glass/mtlx/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "ND_gltf_pbr_surfaceshader"
                    float inputs:alpha = 0.3
                    int inputs:alpha_mode = 2
                    color3f inputs:base_color = (0.2, 0.4, 0.9)
                    color3f inputs:emissive = (0, 0, 0)
                    float inputs:emissive_strength = 1
                    float inputs:metallic = 1
                    float inputs:roughness = 1
                    token outputs:surface
                }
            }
        }

