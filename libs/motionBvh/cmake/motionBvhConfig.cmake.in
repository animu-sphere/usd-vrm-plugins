@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The one declared dependency (WORKSPACE.md §2), arriving with the extractor.
# motionSource's own config pulls motionCore and, through it, the Gf value types
# neither library names here -- so there is deliberately no `find_dependency(pxr)`
# on this line: this library's dependency is motionSource, and reaching past it
# for OpenUSD would be this config asserting an edge the descriptor does not
# declare.
if(NOT TARGET motionSource::motionSource)
    find_dependency(motionSource CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/motionBvhTargets.cmake")
check_required_components(motionBvh)
