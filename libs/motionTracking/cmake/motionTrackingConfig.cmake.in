@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# One dependency and no platform branch: the solve links `motionCore`, which is
# where the Gf value types arrive with it, and nothing else — not a transport,
# not a platform primitive (WORKSPACE.md §2). OpenUSD's pxrConfig.cmake defines
# imported targets unconditionally, so skip it when a consumer has already
# resolved the Gf target this package needs.
if(NOT TARGET gf AND NOT TARGET pxr::gf)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/motionTrackingTargets.cmake")
check_required_components(motionTracking)
